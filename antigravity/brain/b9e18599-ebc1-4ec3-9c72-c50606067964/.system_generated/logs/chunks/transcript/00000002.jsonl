 str, salt: str) -> bool:\\n    new_hash, _ = hash_password(password, salt)\\n    return secrets.compare_digest(new_hash, password_hash)\\n\\ndef create_session_token(user_id: int) -> str:\\n    token = secrets.token_urlsafe(32)\\n    expires_at = (datetime.now() + timedelta(days=30)).isoformat()\\n    with get_connection() as conn:\\n        c = conn.cursor()\\n        c.execute(\\\"\\\"\\\"\\n            INSERT INTO user_sessions (token, user_id, expires_at)\\n            VALUES (?, ?, ?);\\n        \\\"\\\"\\\", (token, user_id, expires_at))\\n        conn.commit()\\n    return token\\n\\ndef get_user_from_token(token: str) -> Optional[Dict[str, Any]]:\\n    if not token:\\n        return None\\n    with get_connection() as conn:\\n        c = conn.cursor()\\n        c.execute(\\\"\\\"\\\"\\n            SELECT u.id, u.name, u.email, u.phone, u.home_location, u.work_location,\\n                   u.travel_mode_preference, u\n<truncated 73077 bytes>","Description":"\"Write production backend builder script\"","Overwrite":"true","TargetFile":"\"C:\\\\Users\\\\akhil\\\\.gemini\\\\antigravity\\\\brain\\\\b9e18599-ebc1-4ec3-9c72-c50606067964\\\\scratch\\\\build_production_backend.py\"","toolAction":"\"Writing production backend script\"","toolSummary":"\"Write production backend script\""}}],"truncated_fields":["tool_calls"]}
