icken Vindaloo & Sorpotel',\n                'Goan Pao with Ross Omelette',\n                'Bebinca (Traditional Multi-layered Goan Dessert)',\n                'Feni & Tender Coconut Cocktails'\n            ]),\n            'attractions': json.dumps([\n                'Basilica of Bom Jesus & Se Cathedral (Old Goa)',\n                'Fort Aguada & Chapora Fort (Dil Chahta Hai viewpoint)',\n                'Palolem, Anjuna & Calangute Beaches',\n                'Dudhsagar Waterfalls (Four-tiered cascade)',\n                'Fontainhas Latin Quarter (Panaji heritage walk)'\n            ]),\n            'hotels': json.dumps([\n                {'name': 'Taj Exotica Resort & Spa (Benaulim)', 'type': '5-Star Beach Resort', 'price_range': '₹18,000 - ₹35,000/night', 'rating': 4.9},\n                {'name': 'Heritage Village Resort & Spa', 'type': 'Boutique Resort', 'price_range': '₹7,000 - ₹12,000/night', 'rating': 4.6},\n                {'name': 'The Hosteller Goa (Anjuna)', 'type': 'Social Hostel', 'price_range': '₹800 - ₹2,500/night', 'rating': 4.5}\n            ]),\n            'activities': json.dumps([\n                'Scuba Diving, Parasailing & Jet Skiing at Grand Island',\n                'Cruising the Mandovi River with Goan folk dance',\n                'Exploring colourful colonial villas in Fontainhas',\n                'Dudhsagar Jungle Jeep Safari & Spice Farm Lunch',\n                'Beach Shack Sunset Dining with Live Acoustic Music'\n            ]),\n            'ratings': 4.8,\n            'approx_cost_per_day': 3800.0,\n            'best_season': 'November to February',\n            'weather_summary': 'Sunny, Coastal Breeze & Tropical (22°C - 32°C)',\n            'image_url': 'https://images.unsplash.com/photo-1512343879784-a960bf40e7f2?w=800&auto=format&fit=crop&q=80',\n            'source': 'local_cache'\n        }\n    ]\n\n    for dest in sample_destinations:\n        cursor.execute('''\n            INSERT INTO destinations (\n                n